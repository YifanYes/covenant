generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(255)
  title                  String?                 @db.VarChar(255)
  factionName            String                  @default("HOLY_KNIGHTS")
  currentClass           String                  @db.VarChar(50)
  data                   Json?                   @default("{\"diceBank\": 0}")
  createdAt              DateTime                @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                @updatedAt @db.Timestamp(6)
  userId                 String                  @unique @db.Uuid
  gold                   Int                     @default(0)
  inventory              Json?                   @default("[]")
  loadout                Json?                   @default("[]")
  magicNature            String?                 @db.VarChar(50)
  activityParticipations ActivityParticipation[]
  classes                CharacterClass[]

  @@map("characters")
}

model CharacterClass {
  id            String    @id @default(uuid()) @db.Uuid
  characterId   String    @db.Uuid
  className     String    @db.VarChar(50)
  health        Int       @default(5)
  mana          Int       @default(5)
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @db.Timestamp(6)
  magicAtk      Int       @default(5)
  magicDef      Int       @default(5)
  strengthAtk   Int       @default(4)
  strengthDef   Int       @default(4)
  manaRegen     Int       @default(1)
  enemiesKilled Json      @default("{\"minion\": 0, \"elite\": 0, \"boss\": 0}")
  tier          Int       @default(1)
  maxHealth     Int       @default(5)
  maxMana       Int       @default(5)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, className])
  @@map("character_classes")
}

model MapActivity {
  id             String                  @id @default(uuid()) @db.Uuid
  activityId     String                  @db.VarChar(255)
  status         String                  @db.VarChar(20)
  progress       Int                     @default(0)
  target         Int
  startedAt      DateTime                @default(now()) @db.Timestamp(6)
  deadline       DateTime                @db.Timestamp(6)
  completedAt    DateTime?               @db.Timestamp(6)
  participations ActivityParticipation[]

  @@map("map_activities")
}

model ActivityParticipation {
  id                    String      @id @default(uuid()) @db.Uuid
  activityId            String      @db.Uuid
  characterId           String      @db.Uuid
  kills                 Int         @default(0)
  goldEarned            Int         @default(0)
  joinedAt              DateTime    @default(now()) @db.Timestamp(6)
  lastCombatAt          DateTime?   @db.Timestamp(6)
  currentEnemyId        String?     @db.VarChar(255)
  currentEnemyHealth    Int?        @default(0)
  currentEnemyMaxHealth Int?        @default(0)
  combatLog             Json?       @default("[]")
  activity              MapActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  character             Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([activityId, characterId])
  @@map("activity_participations")
}

model Objective {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  userId      String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)
  dueDate     DateTime? @db.Timestamp(6)
  completedAt DateTime? @db.Timestamp(6)
  areas       Area[]    @relation("AreaToObjective")
  habits      Habit[]   @relation("HabitToObjective")
  tasks       Task[]    @relation("ObjectiveToTask")

  @@map("objectives")
}

model Area {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(255)
  color      String?     @db.VarChar(255)
  icon       String?     @db.VarChar(255)
  createdAt  DateTime    @default(now()) @db.Timestamp(6)
  updatedAt  DateTime    @updatedAt @db.Timestamp(6)
  userId     String      @db.Uuid
  objectives Objective[] @relation("AreaToObjective")

  @@map("areas")
}

model Task {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(255)
  description String?
  status      String      @db.VarChar(255)
  order       Int         @default(0)
  dueDate     DateTime?   @db.Timestamp(6)
  userId      String      @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)
  color       String?     @db.VarChar(255)
  effort      String?     @db.VarChar(50)
  impact      String?     @db.VarChar(50)
  completedAt DateTime?   @db.Timestamp(6)
  objectives  Objective[] @relation("ObjectiveToTask")

  @@map("tasks")
}

model Habit {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(255)
  description String?
  recurrence  Int               @default(1)
  timespan    String            @db.VarChar(255)
  userId      String            @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @updatedAt @db.Timestamp(6)
  deletedAt   DateTime?         @db.Timestamp(6)
  completions HabitCompletion[]
  objectives  Objective[]       @relation("HabitToObjective")

  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  habitId     String   @db.Uuid
  userId      String   @db.Uuid
  completedAt DateTime @default(now()) @db.Timestamp(6)
  habit       Habit    @relation(fields: [habitId], references: [id])

  @@map("habit_completions")
}
