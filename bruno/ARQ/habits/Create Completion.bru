meta {
  name: Create Completion
  type: http
  seq: 8
}

post {
  url: {{host}}/habits.createCompletion
  body: json
  auth: bearer
}

headers {
  x-refresh-token: {{refresh_token}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "id": "{{habit_id}}"
  }
}

script:post-response {
  const data = res.body?.result?.data
  
  if (data) {
    const habitCompletionId = data.completion?.id
    if (habitCompletionId) bru.setEnvVar('habit_completion_id', habitCompletionId)
  }
  
}
