meta {
  name: Restore
  type: http
  seq: 6
}

post {
  url: {{host}}/habits.restore
  body: json
  auth: bearer
}

headers {
  x-refresh-token: {{refresh_token}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "id": "{{habit_id}}"
  }
}

script:post-response {
  const data = res.body?.result?.data
  
  if (data) {
    bru.setEnvVar('objective_id', '')
  }
}
