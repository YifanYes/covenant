meta {
  name: Delete Completion
  type: http
  seq: 9
}

post {
  url: {{host}}/habits.deleteCompletion
  body: json
  auth: bearer
}

headers {
  x-refresh-token: {{refresh_token}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "id": "{{habit_completion_id}}"
  }
}

script:post-response {
  const data = res.body?.result?.data
  
  if (data) {
    bru.setEnvVar('habit_completion_id', '')
  }
}
