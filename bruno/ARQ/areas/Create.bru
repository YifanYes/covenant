meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{host}}/areas.create
  body: json
  auth: bearer
}

headers {
  x-refresh-token: {{refresh_token}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Finances",
    "color": "#1f241",
    "icon": "MONEY"
  }
}

script:post-response {
  const data = res.body?.result?.data
  
  if (data) {
    const areaId = data.area?.id
    if (areaId) bru.setEnvVar('area_id', areaId)
  }
  
}
