meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{host}}/auth.refreshToken
  body: json
  auth: none
}

body:json {
  {
    "accessToken": "{{access_token}}",
    "refreshToken": "{{refresh_token}}"
  }
}

script:post-response {
  const data = res.body?.result?.data
  
  if (data) {
    const accessToken = data?.accessToken
    const refreshToken = data?.refreshToken
  
    if (accessToken) bru.setEnvVar('access_token', accessToken)
    if (refreshToken) bru.setEnvVar('refresh_token', refreshToken)
  }
  
}
