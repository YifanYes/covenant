meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{host}}/auth.logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const data = res.body?.result?.data

  if (data) {
    bru.setEnvVar('user_id', '')
    bru.setEnvVar('access_token', '')
    bru.setEnvVar('refresh_token', '')
  }
}