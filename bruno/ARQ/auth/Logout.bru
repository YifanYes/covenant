meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{host}}/auth.logout
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar('user_id', '')
  bru.setEnvVar('access_token', '')
  bru.setEnvVar('refresh_token', '')
}
