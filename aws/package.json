{
  "name": "aws",
  "version": "0.1.0",
  "bin": {
    "aws": "bin/aws.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "db:push:prod": "cd ../server && npx tsx scripts/db-push-prod.ts",
    "deploy": "npm run db:push:prod && npm run build:prod --prefix ../front && npx cdk deploy --all"
  },
  "devDependencies": {
    "@aws-cdk/aws-apigatewayv2-alpha": "^2.99.1-alpha.0",
    "@aws-cdk/aws-apigatewayv2-integrations-alpha": "^2.99.1-alpha.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^25.0.6",
    "aws-cdk": "2.99.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.17.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.965.0",
    "@trpc/server": "^11.8.1",
    "@types/aws-lambda": "^8.10.159",
    "aws-cdk-lib": "2.99.1",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}