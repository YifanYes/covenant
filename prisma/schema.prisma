generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth Models
model User {
  id             String          @id
  name           String?
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  theme                String          @default("HOLY_KNIGHTS")
  locale               String          @default("es")
  colorMode            String          @default("light")
  defaultTasksView     String          @default("list")
  dateFormat           String          @default("L")
  tutorialCompletedAt  DateTime?       @db.Timestamp(6)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  sessions             Session[]
  accounts             Account[]
  character            Character?
  journalEntries       JournalEntry[]
  guildMembership      GuildMember?
  ownedGuilds          Guild[]         @relation("GuildOwner")
  guildMessages        GuildMessage[]
  guildReports         GuildMessageReport[]
  tavernMessages       TavernMessage[]
  tavernReports        TavernMessageReport[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Character {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(255)
  title       String?          @db.VarChar(255)
  factionName String           @default("HOLY_KNIGHTS")
  currentClass String          @db.VarChar(50)
  data        Json?            @default("{}")
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
  updatedAt   DateTime         @updatedAt @db.Timestamp(6)
  userId      String           @unique
  gold        Int              @default(0)
  manaReserve Int              @default(0)
  inventory   Json?            @default("[]")
  loadout     Json?            @default("[]")
  magicNature         String?          @db.VarChar(50)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests              CharacterQuest[]
  classes             CharacterClass[]

  @@map("characters")
}

model CharacterClass {
  id                String    @id @default(uuid()) @db.Uuid
  characterId       String    @db.Uuid
  className         String    @db.VarChar(50)
  health            Int       @default(30)
  mana              Int       @default(5)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @db.Timestamp(6)
  magicAtk          Int       @default(5)
  magicDef          Int       @default(5)
  strengthAtk       Int       @default(4)
  strengthDef       Int       @default(4)
  manaRegen         Int       @default(1)
  tier              Int       @default(1)
  maxHealth         Int       @default(30)
  maxMana           Int       @default(5)
  speed             Int       @default(1)
  equippedAbilities String[]  @default([])
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, className])
  @@map("character_classes")
}

model CharacterQuest {
  id                   String        @id @default(uuid()) @db.Uuid
  characterId          String        @db.Uuid
  questId              String        @db.VarChar(255)
  status               String        @db.VarChar(20)
  progress             Int           @default(0)
  target               Int
  goldEarned           Int           @default(0)
  startedAt            DateTime      @default(now()) @db.Timestamp(6)
  completedAt          DateTime?     @db.Timestamp(6)
  activeAbilities      Json?         @default("{}")
  enemyActiveAbilities Json?         @default("{}")
  combatStats          Json?         @default("{}")
  tacticalState        Json?         @default("{}")
  enemies              CombatEnemy[]
  character            Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_quests")
}

model CombatEnemy {
  id               String         @id @default(uuid()) @db.Uuid
  characterQuestId String         @db.Uuid
  templateId       String         @db.VarChar(255)
  namePrefix       String         @db.VarChar(100)
  nameSuffix       String         @db.VarChar(100)
  maxHealth        Int
  currentHealth    Int
  status           String         @default("ACTIVE") @db.VarChar(20)
  spawnedAt        DateTime       @default(now()) @db.Timestamp(6)
  defeatedAt       DateTime?      @db.Timestamp(6)
  turnsElapsed     Int            @default(0)
  damageDealt      Int            @default(0)
  damageTaken      Int            @default(0)
  criticalHits     Int            @default(0)
  combatLog        Json?          @default("[]")
  characterQuest   CharacterQuest @relation(fields: [characterQuestId], references: [id], onDelete: Cascade)

  @@index([characterQuestId])
  @@map("combat_enemies")
}

model Objective {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  userId      String
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)
  dueDate     DateTime? @db.Timestamp(6)
  completedAt DateTime? @db.Timestamp(6)
  areas       Area[]    @relation("AreaToObjective")
  habits      Habit[]   @relation("HabitToObjective")
  tasks       Task[]    @relation("ObjectiveToTask")

  @@index([userId])
  @@map("objectives")
}

model Area {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(255)
  color      String?     @db.VarChar(255)
  icon       String?     @db.VarChar(255)
  createdAt  DateTime    @default(now()) @db.Timestamp(6)
  updatedAt  DateTime    @updatedAt @db.Timestamp(6)
  userId     String
  objectives Objective[] @relation("AreaToObjective")
  tasks      Task[]      @relation("AreaToTask")
  habits     Habit[]     @relation("AreaToHabit")

  @@unique([userId, name])
  @@index([userId])
  @@map("areas")
}

model Task {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(255)
  description String?
  status      String      @db.VarChar(255)
  order       Int         @default(0)
  dueDate     DateTime?   @db.Timestamp(6)
  userId      String
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)
  color       String?     @db.VarChar(255)
  effort      String?     @db.VarChar(50)
  impact      String?     @db.VarChar(50)
  completedAt DateTime?   @db.Timestamp(6)
  objectives  Objective[] @relation("ObjectiveToTask")
  areas       Area[]      @relation("AreaToTask")

  @@index([userId])
  @@map("tasks")
}

model Habit {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(255)
  description String?
  recurrence  Int               @default(1)
  timespan    String            @db.VarChar(255)
  userId      String
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @updatedAt @db.Timestamp(6)
  deletedAt   DateTime?         @db.Timestamp(6)
  completions HabitCompletion[]
  objectives  Objective[]       @relation("HabitToObjective")
  areas       Area[]            @relation("AreaToHabit")

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  habitId     String   @db.Uuid
  userId      String
  completedAt DateTime @default(now()) @db.Timestamp(6)
  habit       Habit    @relation(fields: [habitId], references: [id])

  @@index([habitId])
  @@index([userId])
  @@map("habit_completions")
}

model JournalEntry {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String
  content   String    @db.Text
  mood      String?   @db.VarChar(20)
  color     String?   @db.VarChar(7)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, createdAt])
  @@index([userId, createdAt])
  @@map("journal_entries")
}

model Guild {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String          @db.VarChar(80)
  description        String?         @db.VarChar(500)
  ownerId            String
  factionName        String          @default("HOLY_KNIGHTS")
  capacity           Int             @default(50)
  tier               Int             @default(1)
  totalContribution  Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamp(6)
  updatedAt          DateTime        @updatedAt @db.Timestamp(6)
  members     GuildMember[]
  messages    GuildMessage[]
  invites     GuildInvite[]
  campaigns   GuildCampaign[]
  owner       User            @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("guilds")
}

model GuildMember {
  id       String   @id @default(uuid()) @db.Uuid
  guildId  String   @db.Uuid
  userId   String
  role     String   @default("MEMBER") @db.VarChar(20)
  joinedAt DateTime @default(now()) @db.Timestamp(6)
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([guildId])
  @@map("guild_members")
}

model GuildMessage {
  id          String                @id @default(uuid()) @db.Uuid
  guildId     String                @db.Uuid
  userId      String
  content     String                @db.VarChar(2000)
  createdAt   DateTime              @default(now()) @db.Timestamp(6)
  deletedAt   DateTime?             @db.Timestamp(6)
  reportCount Int                   @default(0)
  guild       Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     GuildMessageReport[]

  @@index([guildId, createdAt, id])
  @@map("guild_messages")
}

model GuildMessageReport {
  id         String       @id @default(uuid()) @db.Uuid
  messageId  String       @db.Uuid
  reporterId String
  reason     String?      @db.VarChar(255)
  createdAt  DateTime     @default(now()) @db.Timestamp(6)
  message    GuildMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@map("guild_message_reports")
}

model GuildInvite {
  id        String    @id @default(uuid()) @db.Uuid
  guildId   String    @db.Uuid
  token     String    @unique @db.VarChar(64)
  createdBy String
  expiresAt DateTime  @db.Timestamp(6)
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  revokedAt DateTime? @db.Timestamp(6)
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_invites")
}

model GuildCampaign {
  id               String                  @id @default(uuid()) @db.Uuid
  guildId          String                  @db.Uuid
  templateId       String                  @db.VarChar(64)
  eventType        String                  @db.VarChar(32)
  target           Int
  progress         Int                     @default(0)
  rewardPool       Json
  startedBy        String
  startedAt        DateTime                @default(now()) @db.Timestamp(6)
  expiresAt        DateTime                @db.Timestamp(6)
  completedAt      DateTime?               @db.Timestamp(6)
  contributorCount Int?
  guild            Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progressEntries  GuildCampaignProgress[]

  @@index([guildId, completedAt])
  @@index([guildId, expiresAt])
  @@map("guild_campaigns")
}

model GuildCampaignProgress {
  id           String        @id @default(uuid()) @db.Uuid
  campaignId   String        @db.Uuid
  userId       String
  contribution Int           @default(0)
  claimedAt    DateTime?     @db.Timestamp(6)
  goldClaimed  Int           @default(0)
  updatedAt    DateTime      @updatedAt @db.Timestamp(6)
  campaign     GuildCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@map("guild_campaign_progress")
}

model TavernMessage {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  characterId String    @db.Uuid
  content     String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  deletedAt   DateTime? @db.Timestamp(6)
  reportCount Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     TavernMessageReport[]

  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@map("tavern_messages")
}

model TavernMessageReport {
  id         String        @id @default(uuid()) @db.Uuid
  messageId  String        @db.Uuid
  reporterId String
  reason     String?       @db.VarChar(255)
  createdAt  DateTime      @default(now()) @db.Timestamp(6)
  message    TavernMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@map("tavern_message_reports")
}
