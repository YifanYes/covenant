NODE_ENV=dev
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=debug

# Transactional email via Brevo HTTP API (required in production for verification and
# password-reset flows; optional in dev/test). See docs/guides/email_brevo_setup.md.
BREVO_API_KEY=
FROM_EMAIL=

# Distributed rate-limit backing store (Upstash Redis REST API). Required in production
# so rate limits hold across replicas and survive restarts; optional in dev/test (falls
# back to in-memory per-instance state).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring (optional in dev, required in production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: overrides NODE_ENV in Sentry tags (useful for staging / preview environments)
ENVIRONMENT=dev
NEXT_PUBLIC_ENVIRONMENT=dev

# PostHog product analytics + feature flags (EU Cloud). Optional in dev/test; init is
# gated on NODE_ENV=production so unset keys outside prod simply no-op.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
