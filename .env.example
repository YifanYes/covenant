NODE_ENV=dev
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=debug

# Sentry error monitoring (optional in dev, required in production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: overrides NODE_ENV in Sentry tags (useful for staging / preview environments)
ENVIRONMENT=dev
NEXT_PUBLIC_ENVIRONMENT=dev
